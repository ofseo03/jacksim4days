# Supabase (없으면 로컬 전용 모드로 동작)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 네이버 로그인 (Supabase 미지원 제공자 — 커스텀 플로우, 서버 전용 키)
# https://developers.naver.com/apps 에서 발급
# Callback URL: {배포주소}/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Supabase Dashboard → Settings → API → service_role (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=
